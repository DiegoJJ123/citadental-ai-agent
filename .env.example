# OpenAI (GPT)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Nombre de la clínica ficticia y datos de la demo
CLINIC_NAME=CitaDental
PORT=3000

# Número(s) de humano al que "escalar" (solo para loggear/notificar, opcional)
HUMAN_HANDOFF_NOTICE=Un compañero del equipo seguirá la conversación en breve.

# Número de WhatsApp del equipo comercial (formato E.164 sin +, ej. 34600000000)
# Recibe un aviso automático cada vez que el bot registra un lead de demo (dueño de clínica interesado en el producto)
SALES_TEAM_PHONE=34600000000

# Generación y publicación automática de contenido en Instagram
# URL pública del bot (Render), necesaria para que Instagram pueda leer la imagen generada
BASE_URL=https://citadental-ai-bot.onrender.com
# ID de la cuenta de Instagram Business/Creator (debe estar vinculada a una Página de Facebook)
IG_BUSINESS_ACCOUNT_ID=17841400000000000
# Token de acceso (de página, de larga duración) con permisos instagram_basic + instagram_content_publish + pages_show_list
IG_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxx

# Dashboard privado en /dashboard — login con Google (OAuth Client de Google Cloud Console)
# restringido a un único email
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
ALLOWED_DASHBOARD_EMAIL=tucorreo@gmail.com
# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
